#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# ============================================
# 1. Lint for buttons without handlers
# ============================================
echo "📋 Checking for buttons without onClick handlers..."

# Find Button components without onClick in frontend
BUTTONS_WITHOUT_HANDLERS=$(grep -rn "<Button" frontend/src --include="*.tsx" | grep -v "onClick" | grep -v "type=\"submit\"" | grep -v "disabled" | grep -v ".test.tsx" | grep -v "node_modules")

if [ -n "$BUTTONS_WITHOUT_HANDLERS" ]; then
  echo "❌ ERROR: Found buttons without onClick handlers:"
  echo "$BUTTONS_WITHOUT_HANDLERS"
  echo ""
  echo "Fix: Add onClick handler to each Button or use type=\"submit\" for form buttons"
  exit 1
fi

echo "✅ All buttons have handlers"

# ============================================
# 2. Check for empty href links
# ============================================
echo "📋 Checking for links without href..."

EMPTY_HREF_LINKS=$(grep -rn 'href=""' frontend/src --include="*.tsx" | grep -v ".test.tsx" | grep -v "node_modules")
HASH_HREF_LINKS=$(grep -rn 'href="#"' frontend/src --include="*.tsx" | grep -v ".test.tsx" | grep -v "node_modules")

if [ -n "$EMPTY_HREF_LINKS" ] || [ -n "$HASH_HREF_LINKS" ]; then
  echo "❌ ERROR: Found links with empty or # href:"
  echo "$EMPTY_HREF_LINKS"
  echo "$HASH_HREF_LINKS"
  exit 1
fi

echo "✅ All links have valid hrefs"

# ============================================
# 3. Run audit tests
# ============================================
echo "📋 Running audit tests..."

cd frontend

# Run only audit tests (fast)
npm run test:audit --silent 2>/dev/null

if [ $? -ne 0 ]; then
  echo "❌ ERROR: Audit tests failed"
  echo "Run 'npm run test:audit' to see details"
  exit 1
fi

echo "✅ Audit tests passed"

# ============================================
# 4. Run unit tests for changed files
# ============================================
echo "📋 Running tests for changed files..."

# Get changed .tsx files
CHANGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.tsx?$' | grep -v '\.test\.')

if [ -n "$CHANGED_FILES" ]; then
  # Run tests related to changed files
  npm run test:changed --silent 2>/dev/null
  
  if [ $? -ne 0 ]; then
    echo "❌ ERROR: Tests for changed files failed"
    exit 1
  fi
  
  echo "✅ Tests for changed files passed"
else
  echo "ℹ️ No TypeScript files changed, skipping related tests"
fi

# ============================================
# 5. TypeScript type check
# ============================================
echo "📋 Running TypeScript type check..."

npx tsc --noEmit --skipLibCheck 2>/dev/null

if [ $? -ne 0 ]; then
  echo "❌ ERROR: TypeScript errors found"
  echo "Run 'npx tsc --noEmit' to see details"
  exit 1
fi

echo "✅ TypeScript check passed"

# ============================================
# All checks passed
# ============================================
echo ""
echo "🎉 All pre-commit checks passed!"
echo ""

